<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CarbonWindowBrush" Color="#0F141A" />
      <SolidColorBrush x:Key="CarbonPanelBrush" Color="#141A21" />
      <SolidColorBrush x:Key="CarbonActivityBarBrush" Color="#0B0F14" />
      <SolidColorBrush x:Key="CarbonEditorBrush" Color="#10161D" />
      <SolidColorBrush x:Key="CarbonBorderBrush" Color="#232C36" />
      <SolidColorBrush x:Key="CarbonTextBrush" Color="#E6EDF3" />
      <SolidColorBrush x:Key="CarbonMutedTextBrush" Color="#8B98A5" />
      <SolidColorBrush x:Key="CarbonOverlayBrush" Color="#99000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CarbonWindowBrush" Color="#0F141A" />
      <SolidColorBrush x:Key="CarbonPanelBrush" Color="#141A21" />
      <SolidColorBrush x:Key="CarbonActivityBarBrush" Color="#0B0F14" />
      <SolidColorBrush x:Key="CarbonEditorBrush" Color="#10161D" />
      <SolidColorBrush x:Key="CarbonBorderBrush" Color="#232C36" />
      <SolidColorBrush x:Key="CarbonTextBrush" Color="#E6EDF3" />
      <SolidColorBrush x:Key="CarbonMutedTextBrush" Color="#8B98A5" />
      <SolidColorBrush x:Key="CarbonOverlayBrush" Color="#99000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CarbonWindowBrush" Color="#F3F5F7" />
      <SolidColorBrush x:Key="CarbonPanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CarbonActivityBarBrush" Color="#E4E8EC" />
      <SolidColorBrush x:Key="CarbonEditorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CarbonBorderBrush" Color="#D3DAE1" />
      <SolidColorBrush x:Key="CarbonTextBrush" Color="#1B232B" />
      <SolidColorBrush x:Key="CarbonMutedTextBrush" Color="#5C6773" />
      <SolidColorBrush x:Key="CarbonOverlayBrush" Color="#66000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="60" />
    <Setter Property="Foreground" Value="{ThemeResource CarbonMutedTextBrush}" />
  </Style>
</ResourceDictionary>
