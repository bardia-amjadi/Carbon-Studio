<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CarbonStudio.App.CarbonApplication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/CarbonTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- One shared instance: changing its Color at runtime recolours everything bound to it. -->
      <SolidColorBrush x:Key="CarbonAccentBrush" Color="#38BDF8" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
