<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CarbonStudio</AssemblyName>
    <RootNamespace>CarbonStudio.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 is the minimum supported by Windows App SDK 1.8. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, self-contained: installable with a plain MSI and no MSIX signing requirement. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CarbonStudio.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The editor's npm project lives inside this folder; keep its node_modules out of MSBuild item globbing. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Editor\web\node_modules\**;Editor\web\test\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarbonStudio.Core\CarbonStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\CarbonStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Monaco editor bundle, produced by `npm ci && npm run build` in Editor\web (git-ignored; CI builds it). -->
    <Content Include="Assets\editor\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WarnIfEditorBundleMissing" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\editor\index.html')">
    <Warning Code="CARBON001" Text="The Monaco editor bundle is missing (Assets\editor\index.html). The app will fall back to the basic text editor. Run 'npm ci' then 'npm run build' in src\CarbonStudio.App\Editor\web; CI does this automatically." />
  </Target>
</Project>
