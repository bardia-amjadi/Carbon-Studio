<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CarbonStudio.App.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CarbonStudio.App.Controls"
    xmlns:workspace="using:CarbonStudio.Core.Workspace">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{ThemeResource CarbonEditorBrush}">
    <StackPanel MaxWidth="720" Margin="48,56,48,32" Spacing="28" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <controls:CarbonLogo Width="72" Height="72" />
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Carbon Studio" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource CarbonTextBrush}" />
          <TextBlock Text="A local-first development environment for Windows" Foreground="{ThemeResource CarbonMutedTextBrush}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="START" Style="{StaticResource PanelHeaderTextStyle}" />
        <HyperlinkButton Padding="0" Click="OnOpenFolderClick" AutomationProperties.Name="Open folder">
          <TextBlock Text="Open Folder…" />
        </HyperlinkButton>
        <HyperlinkButton Padding="0" Click="OnOpenFileClick" AutomationProperties.Name="Open file">
          <TextBlock Text="Open File…" />
        </HyperlinkButton>
        <HyperlinkButton Padding="0" Click="OnNewFileClick" AutomationProperties.Name="New file">
          <TextBlock Text="New File" />
        </HyperlinkButton>
        <HyperlinkButton Padding="0" Click="OnPaletteClick" AutomationProperties.Name="Command palette">
          <TextBlock Text="Command Palette  (Ctrl+Shift+P)" />
        </HyperlinkButton>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="RECENT" Style="{StaticResource PanelHeaderTextStyle}" />
        <TextBlock x:Name="NoRecentText" Text="No recent folders yet. Folders you open appear here." Foreground="{ThemeResource CarbonMutedTextBrush}" />
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="workspace:RecentProject">
              <Grid ColumnSpacing="8" Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton Padding="0" Tag="{x:Bind Path}" Click="OnRecentClick" HorizontalContentAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Path}" Foreground="{ThemeResource CarbonMutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                  </StackPanel>
                </HyperlinkButton>
                <Button Grid.Column="1" Tag="{x:Bind Path}" Click="OnRecentRemoveClick" Padding="6,2"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Remove from recent list" AutomationProperties.Name="Remove from recent list">
                  <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="STATUS" Style="{StaticResource PanelHeaderTextStyle}" />
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource CarbonMutedTextBrush}"
                   Text="Phase 1 foundation: folder workspaces, explorer, tabbed plain-text editing, themes and settings. The professional code editor, project templates, build and run, terminal, Git and language services arrive in later phases." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
